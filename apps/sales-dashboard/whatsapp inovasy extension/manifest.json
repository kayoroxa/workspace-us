{
  "manifest_version": 3,
  "name": "Inovasy Helper for WhatsApp Web",
  "version": "1.0.1",
  "description": "Ferramentas Inovasy no WhatsApp Web. Nao afiliado ao WhatsApp/Meta.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://inovasy-sells-dashboard.netlify.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
